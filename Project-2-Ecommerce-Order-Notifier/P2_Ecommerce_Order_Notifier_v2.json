      "id": "a533467e-c89d-44ea-ae59-c915a22ec140",
      "name": "Google Sheets - Log Failure",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        608,
        656
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "RTJYOVakObILuFYm",
          "name": "Google Sheets account"
        }
      },
      "notes": "Appends a row for every failure, whichever branch it came from - both Set nodes output the same 4 field names (timestamp, failedNode, errorMessage, orderPayload), so both connect here safely."
    }
