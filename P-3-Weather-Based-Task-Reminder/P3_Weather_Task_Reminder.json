      "id": "1c1bc08a-ee5b-483d-ad3f-7e2d8281930e",
      "name": "Get Forecast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1472,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "// Read the raw forecast list from the HTTP Request node\nconst response = $input.first().json;\nconst items = response.list || [];\n\n// Work out \"tomorrow\" in IST, regardless of instance/server timezone\nconst nowIST = DateTime.now().setZone('Asia/Kolkata');\nconst tomorrow = nowIST.plus({ days: 1 }).toFormat('yyyy-MM-dd');\n\n// OpenWeatherMap 5-day/3-hour forecast returns dt (unix UTC) + dt_txt (UTC text)\n// Convert each slot's dt to IST before comparing dates, so we don't miscount\n// slots near the UTC midnight boundary.\nconst tomorrowSlots = items.filter((item) => {\n  const slotIST = DateTime.fromSeconds(item.dt, { zone: 'utc' }).setZone('Asia/Kolkata');\n  return slotIST.toFormat('yyyy-MM-dd') === tomorrow;\n});\n\n// Only ONE rainy slot in the day is enough to trigger a WFH event\nconst rainDetected = tomorrowSlots.some((slot) => {\n  const conditions = (slot.weather || []).map((w) => (w.main || '').toLowerCase());\n  const hasRainCondition = conditions.some((c) =>\n    ['rain', 'thunderstorm', 'drizzle'].includes(c)\n  );\n  const hasRainVolume = !!slot.rain; // OWM sometimes attaches a `rain` object even without a Rain label\n  return hasRainCondition || hasRainVolume;\n});\n\nreturn [\n  {\n    json: {\n      rainDetected,\n      tomorrowDate: tomorrow,\n      matchedSlotCount: tomorrowSlots.length,\n      slotSummaries: tomorrowSlots.map((s) => ({\n        time: s.dt_txt,\n        condition: s.weather && s.weather[0] ? s.weather[0].main : 'Unknown'\n      }))\n    }\n  }\n];"
      },
      "id": "61c3cd47-9b51-4166-afd4-47262d843880",
      "name": "Find Tomorrow Rain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1264,
        -64
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1e6f3c0-2222-4a2b-8c3d-000000000001",
              "leftValue": "={{ $json.rainDetected }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ef32a800-4e48-4ee5-9d02-df4e3dbeaba5",
